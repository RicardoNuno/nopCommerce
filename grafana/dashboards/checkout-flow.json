{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Is checkout working?",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Orders Completed (success / failure)",
      "description": "Metric 1: Rate of completed orders by outcome. A rising failure rate or dropping success rate means checkout is broken. Drill into traces for specific failure reasons.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "rate(nopcommerce_checkout_orders_completed_total{status=\"success\"}[5m])",
          "legendFormat": "success"
        },
        {
          "expr": "rate(nopcommerce_checkout_orders_completed_total{status=\"failure\"}[5m])",
          "legendFormat": "failure"
        }
      ]
    },
    {
      "title": "Orders In Flight",
      "description": "Metric 2: Number of orders currently being processed. A rising value under load means orders are piling up faster than they complete.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nopcommerce_checkout_orders_in_flight",
          "legendFormat": "in-flight orders"
        }
      ]
    },
    {
      "title": "Where is time being spent?",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "title": "Payment Gateway Latency (p50 / p95 / p99)",
      "description": "Metric 3: Duration of payment gateway calls. A climbing p95 indicates the payment provider is degrading before users see timeouts.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(nopcommerce_checkout_payment_gateway_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(nopcommerce_checkout_payment_gateway_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(nopcommerce_checkout_payment_gateway_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Event Dispatch Duration (OrderPlacedEvent)",
      "description": "Metric 4: Time spent dispatching OrderPlacedEvent to all consumers. A climbing value means a consumer is slowing down the checkout response.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(nopcommerce_checkout_event_dispatch_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(nopcommerce_checkout_event_dispatch_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "title": "Error rate",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "title": "Checkout Error Rate",
      "description": "Percentage of order placements that fail. Computed from the business-level orders completed counter (Metric 1). A rising error rate means checkout is degrading — drill into traces or the success/failure panel for details.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(nopcommerce_checkout_orders_completed_total{status=\"failure\"}[5m])) / sum(rate(nopcommerce_checkout_orders_completed_total[5m]))",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "title": "Traces",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "title": "Checkout Flow Traces",
      "description": "Distributed traces for the checkout flow. Click a trace to see the full span hierarchy from HTTP entry point through payment, inventory, and event dispatch.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name = \"NopCommerce\" && name = \"order.place\"}",
          "limit": 20,
          "tableType": "traces",
          "datasource": { "type": "tempo", "uid": "tempo" }
        }
      ]
    }
  ],
  "title": "nopCommerce Checkout Flow",
  "uid": "nopcommerce-checkout",
  "version": 4,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s"
}
